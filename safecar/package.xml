<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>safecar</name>
  <version>0.1.0</version>
  <description>SafeCar 안전 감독 레이어: 인지(차선) · 제어(안전 게이트, 차선 추종, 갓길 대피) · 통신(운전자 이상 신호) + 통합 launch</description>
  <maintainer email="kimseungwp@yu.ac.kr">Seungje Kim</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- launch/safecar.launch.py가 띄우는 외부/벤더 패키지 -->
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>stella_bringup</exec_depend>
  <exec_depend>stella_hailo_rpi5_ros2_examples</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
