<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stella_bringup</name>
  <version>2.2.0</version>
  <description>
    ROS 2 launch scripts for starting the STELLA
  </description>
  <maintainer email="lab@ntrex.co.kr">NTREX LAB</maintainer>
  <license>Apache License 2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- launch/robot.launch.py가 include하는 차체 드라이버 -->
  <exec_depend>stella_md</exec_depend>
  <exec_depend>stella_ahrs</exec_depend>
  <exec_depend>ydlidar</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
